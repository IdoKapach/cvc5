(set-logic QF_GOR)
(set-info :status sat)
(declare-sort S 0)
(declare-const x S)
(declare-const y S)
(declare-const z S)
(declare-const w Int)
(declare-const t Int)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(assert (= w 6))
