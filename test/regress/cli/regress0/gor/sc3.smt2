(set-logic HO_QF_GOR)
(set-info :status unsat)
(declare-sort S 0)
(declare-const x S)
(declare-const y S)
(declare-const z S)
(declare-fun x0 (Int) Bool)
(declare-fun x1 (Int) Bool)
(assert (gor.< x y))
(assert (gor.< y z))
(assert (gor.< z x))
(assert (gor.< x0 x1))
(assert (gor.< x1 x1))
(check-sat)