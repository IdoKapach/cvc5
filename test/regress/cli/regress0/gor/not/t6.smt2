(set-logic QF_GOR)
(set-info :status sat)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-const a Int)
(declare-const b Int)
(declare-const w Int)
(declare-const t Int)
(declare-const p Int)
(declare-const q Int)
(assert (gor.< x y))
(assert (gor.< y z))
(assert (gor.< z a))
(assert (gor.< a b))
(assert (gor.< b w))
(assert (gor.< w t))
(assert (gor.< t p))
(assert (gor.< p q))

(assert (not (gor.< b x)))
(assert (not (gor.< a y)))
(assert (not (gor.< y x)))
(check-sat)